/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  WJ_Set_leftPWM(0);
  WJ_Set_rightPWM(0);
  /* USER CODE BEGIN 2 */
  /* 必须放在 USER CODE 区内, 否则 CubeMX 重新生成会被删掉 */
  HAL_TIM_Encoder_Start(&htim3, TIM_CHANNEL_ALL);
  HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL);
  HAL_Delay(20);
  OLED_Init();
  HAL_UART_Receive_IT(&huart2,&lanya_data,1);
  HAL_UART_Receive_IT(&huart1,&JY61P_Data[0],1);
  PID_Init(&angle);
  PID_Init(&speed);
  angle.ErrorInt=0;
  angle.Kp=14;
  angle.Ki=0.4;
  angle.Kd=56;
  angle.OutMax=500;
  angle.OutMin=-500;
  angle.IntMax=1000;	/* 积分限幅: Ki*1000 = 400, 不会顶死在 OutMax */
  speed.ErrorInt=0;
  /* 速度外环默认关闭(Kp=0), 保证上电后仍是已验证过的纯角度环平衡车。
   * 启用步骤: 手持车、轮子悬空, 发 $v,0.02,0,0 把 Kp 设成 0.02,
   * 再用 $v,50 给目标速度, 观察 speed.Out 的符号:
   *   车应当朝"能抵消该转速"的方向倾斜; 如果反而加速跑开, 说明符号反了,
   *   把 Kp 改成负值(或给遥控速度取负)。
   * 确认方向正确后再逐步加大到 0.05 左右, 最后加积分 Ki ≈ Kp/80。 */
  speed.Kp=0.0;
  speed.Ki=0.0;
  speed.Kd=0.0;			/* 编码器差分量化噪声大, 不加微分 */
  speed.OutMax=8;		/* 输出是目标倾角(度), 不是 PWM: 8 度已经是很猛的加速 */
  speed.OutMin=-8;
  speed.IntMax=0;		/* Ki=0 时不积分; 发 $v,kp,ki,kd 会自动重算 */
  PID_Init(&dif);
  dif.Kp=5.0;			/* 输出就是 PWM: 30rpm 转速差 -> 150 PWM, 手感明显 */
  dif.Ki=0.0;			/* 先用纯 P, 转向抖/超调就减半, 迟钝就加倍 */
  dif.Kd=0.0;			/* 编码器差分有量化噪声, 不加微分 */
  dif.OutMax=400;
  dif.OutMin=-400;
  dif.IntMax=0;			/* Ki=0 时不积分; 发 $d,kp,ki,kd 会自动重算 */
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  OLED_NewFrame();
	  OLED_PrintASCIIString(0, 0,"Pitch:",&afont16x8, OLED_COLOR_NORMAL);
	  OLED_PrintASCIIString(0, 16,"Kp:",&afont16x8, OLED_COLOR_NORMAL);
	  OLED_PrintASCIIString(0, 32,"Ki:",&afont16x8, OLED_COLOR_NORMAL);
	  OLED_PrintASCIIString(0, 48,"Kd:",&afont16x8, OLED_COLOR_NORMAL);
	  /* 小数: 第二个数字参数是小数位数(0~6) */
	  OLED_PrintFloat(48, 0,Pitch-16.2,2, &afont16x8, OLED_COLOR_NORMAL);
	  OLED_PrintFloat(48, 16,speed.Kp,2, &afont16x8, OLED_COLOR_NORMAL);
	  OLED_PrintFloat(48, 32,speed.Ki,2, &afont16x8, OLED_COLOR_NORMAL);
	  OLED_PrintFloat(48, 48,speed.Kd,2, &afont16x8, OLED_COLOR_NORMAL);
	  OLED_ShowFrame();
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
